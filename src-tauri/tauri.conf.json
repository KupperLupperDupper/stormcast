{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stormcast",
  "version": "../package.json",
  "identifier": "io.github.kupperlupperdupper.stormcast",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Stormcast",
    "homepage": "https://github.com/KupperLupperDupper/stormcast",
    "category": "Utility",
    "shortDescription": "Mirror an Android screen over USB",
    "longDescription": "Stormcast mirrors the screen of an Android device to Windows over USB, using the scrcpy server on the device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
